{
  "name": "sfelf-triage",
  "version": "0.2.0",
  "description": "Standalone forensic triage for Salesforce EventLogFile CSVs",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cclabsnz/sfelf-triage.git"
  },
  "homepage": "https://github.com/cclabsnz/sfelf-triage#readme",
  "bugs": {
    "url": "https://github.com/cclabsnz/sfelf-triage/issues"
  },
  "author": "Gaurav Thakur",
  "keywords": [
    "salesforce",
    "eventlogfile",
    "forensics",
    "incident-response",
    "security",
    "guest-user",
    "experience-cloud",
    "log4shell",
    "triage",
    "cli"
  ],
  "bin": {
    "sfelf-triage": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "cli-table3": "0.6.5",
    "commander": "12.1.0",
    "csv-parse": "5.5.6",
    "ipaddr.js": "2.2.0",
    "re2": "1.26.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.5.4",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "re2"
    ],
    "overrides": {
      "tar": ">=7.5.21",
      "brace-expansion": ">=5.0.8",
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0",
      "ip-address": ">=10.3.1"
    }
  }
}
